# No credentials, database or paid external services are required.
PORT=3000
# Set an actual HTTPS origin before generating canonical/OG metadata.
# The existing production origin can be used only for a production candidate build.
SITE_ORIGIN=
# Test projects must keep this false; production indexing requires explicit approval.
ALLOW_INDEXING=false
# Use disk assets for local development. Release binary embeds the generated assets.
DEV_FILES=true
